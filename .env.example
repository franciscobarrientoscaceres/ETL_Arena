# Copiar a .env y completar. Nunca versionar .env.

# Conexión SQL Server (requiere "ODBC Driver 18 for SQL Server"). Usar UNA de las dos (ADR-10).
# a) Desarrollo en instancia local con autenticación Windows (sin contraseña):
ETL_ARENA_DB_URL=mssql+pyodbc://@FRANCISCO-PC\SQLSERVER2025DEV/ETL_Arena?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# b) Login SQL de mínimo privilegio (contenedor Docker o producción):
# ETL_ARENA_DB_URL=mssql+pyodbc://etl_writer:CAMBIAR@localhost:1433/ETL_Arena?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Contraseña SA del contenedor de desarrollo (docker/mssql.compose.yml)
MSSQL_SA_PASSWORD=CAMBIAR_Password_Seguro_1

# Libro maestro (solo lectura; los tests golden lo usan)
ETL_ARENA_XLSM=data/AvailabilityCalculation_PCS&Batteries_20260907_septiembre 2026.xlsm

# Webhook de notificación a Power BI / Misael (opcional; vacío = notificacion.md)
ETL_ARENA_NOTIFY_WEBHOOK=
