# Archivo de configuración de ESTE computador.
# Cómo usarlo: copiarlo como ".env" (Copy-Item .env.example .env) y revisar las líneas de abajo.
# El archivo .env nunca se sube a GitHub. No lleva contraseñas. Guía: docs/instalacion.md (paso 5).
# Las líneas que empiezan con "#" son comentarios (no hacen nada).

# ---------------------------------------------------------------------------
# 1. Base de datos PROD (oficial): trina_etl en Azure, entrar con la cuenta @trinasolar.com.
#    Es el valor por defecto del código: si se borra la línea, se usa igual.
# ---------------------------------------------------------------------------
ETL_ARENA_DB_URL=mssql+pyodbc://@trina-etl.database.windows.net:1433/trina_etl?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
ETL_ARENA_DB_AUTH=entra

# ---------------------------------------------------------------------------
# 2. Base de datos TEST/QA (--entorno prueba / qa / test): trina_etl_prueba, para practicar sin tocar PROD.
#    También es valor por defecto del código. Nunca puede ser la misma base que PROD.
# ---------------------------------------------------------------------------
ETL_ARENA_DB_URL_PRUEBA=mssql+pyodbc://@trina-etl.database.windows.net:1433/trina_etl_prueba?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Entorno por defecto si no se indica --entorno (produccion o prueba):
# ETL_ARENA_ENTORNO=produccion

# ---------------------------------------------------------------------------
# 3. Aviso a Power BI / Misael (opcional). Vacío = se escribe notificacion.md en la carpeta del corte.
# ---------------------------------------------------------------------------
ETL_ARENA_NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# 4. Solo para desarrolladores (se pueden dejar tal cual)
# ---------------------------------------------------------------------------
# Libro usado por las pruebas automáticas "golden":
ETL_ARENA_XLSM=data/AvailabilityCalculation_PCS&Batteries_20260907_septiembre 2026.xlsm
# Base para los tests automáticos de integración SQL: los tests la BORRAN y la vuelven a crear.
# NUNCA poner aquí trina_etl (PROD) ni trina_etl_prueba (TEST/QA). Sin esta línea, esos tests se saltan.
# ETL_ARENA_TEST_DB_URL=mssql+pyodbc://@FRANCISCO-PC\SQLSERVER2025DEV/ETL_Arena_test?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# Alternativas a la base oficial (en lugar de la línea 1):
#  a) SQL Server local con autenticación de Windows:
# ETL_ARENA_DB_URL=mssql+pyodbc://@FRANCISCO-PC\SQLSERVER2025DEV/ETL_Arena?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
#  b) Usuario SQL de mínimo privilegio (rol etl_writer):
# ETL_ARENA_DB_URL=mssql+pyodbc://etl_writer:CAMBIAR@localhost:1433/ETL_Arena?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
